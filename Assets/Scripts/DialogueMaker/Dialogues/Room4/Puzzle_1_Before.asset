    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0a0000000b0000000c0000000d0000000d0000000d0000001b0000001b0000004300000043000000430000004300000043000000
    functionCalls: []
  - text: "Let\u2019s talk about this later, $$$right now we have to get out of here,
