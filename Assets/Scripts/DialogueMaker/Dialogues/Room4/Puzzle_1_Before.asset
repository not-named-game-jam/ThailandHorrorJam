    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: 'For some reason, $$I cannot recall the first time we met, $$and how we
      got this close. '
    displayText: 'For some reason, I cannot recall the first time we met, and how
      we got this close. '
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
