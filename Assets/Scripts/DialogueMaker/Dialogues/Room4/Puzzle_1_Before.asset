    pauseIndex: 00000000010000000200000003000000
    functionCalls: []
  - text: "It\u2019s fine\u2026$$$$$$$ You can take your time. "
    displayText: "It\u2019s fine\u2026 You can take your time. "
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
