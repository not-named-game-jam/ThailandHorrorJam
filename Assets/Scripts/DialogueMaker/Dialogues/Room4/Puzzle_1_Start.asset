    pauseIndex: 0200000003000000040000000500000005000000050000002f0000002f0000002f000000
    functionCalls: []
  - text: Oh! $$I think I get it now! $$$Looks like we just have to pick a date right?
    displayText: Oh! I think I get it now! Looks like we just have to pick a date
      right?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
