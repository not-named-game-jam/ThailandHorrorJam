    pauseIndex: 0b0000000b0000000b0000002b0000002b0000002b000000
    functionCalls: []
  - text: "Hm$.$.$.$$$ \nRight here it says, \"All but one lied.\" $$$ \nI think
      this is referring to those scribbles."
    displayText: "Hm... \nRight here it says, \"All but one lied.\"  \nI think this
      is referring to those scribbles."
