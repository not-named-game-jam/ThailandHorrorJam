  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd46f4c48ea13f644b49af6b289fdb82, type: 3}
  m_Name: Plum blossom pot (cleaned)
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: That flower is so beautiful. $$Why would someone break it like that, $$even
      if it's in a dream.$.$.
    displayText: That flower is so beautiful. Why would someone break it like that,
      even if it's in a dream...
    color: 0
    characterSprite: {fileID: 21300000, guid: 708777bab44cd2f45b2812ba56f77be9, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1d0000001d00000043000000430000005b0000005c000000
    functionCalls: []
  - text: Rika?
    displayText: Rika?
    color: 0
    characterSprite: {fileID: 21300000, guid: 72c3981eaae6be5468be6dc68fac3515, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Yes.
    displayText: Yes.
    color: 0
    characterSprite: {fileID: 21300000, guid: 163aeeba01ab15e40828b78dd5e2482f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: It is.$.$. $$beautiful.$.$.
    displayText: It is... beautiful...
    color: 0
    characterSprite: {fileID: 21300000, guid: a32fafbf821b6c84ca74a356f7b9b009, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 060000000700000009000000090000001300000014000000
    functionCalls: []
  - text: Haha.$.$.
    displayText: Haha...
    color: 0
    characterSprite: {fileID: 21300000, guid: 708777bab44cd2f45b2812ba56f77be9, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0500000006000000
    functionCalls: []
  - text: Rika?
    displayText: Rika?
    color: 0
    characterSprite: {fileID: 21300000, guid: b4e91975d53cca641b0139806b4b5627, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '                                                                 '
    displayText: '                                                                 '
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 3
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru.$.$. $$How can I forget you? $$My first real friend.$.$.
    displayText: Mahiru... How can I forget you? My first real friend...
    color: 0
    characterSprite: {fileID: 21300000, guid: 708777bab44cd2f45b2812ba56f77be9, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 07000000080000000a0000000a00000020000000200000003500000036000000
    functionCalls: []
  - text: .$.$.Rika, $$you remember her now?
    displayText: ...Rika, you remember her now?
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 01000000020000000900000009000000
    functionCalls: []
  - text: Yeah.$.$.
    displayText: Yeah...
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0500000006000000
    functionCalls: []
  - text: I met her first when I entered high school. $$She was always wearing a
      plum blossom with her and always acted very stupidly and cute.
    displayText: I met her first when I entered high school. She was always wearing
      a plum blossom with her and always acted very stupidly and cute.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2c0000002c000000
    functionCalls: []
  - text: In the middle of an environment where everyone tries to manipulate others
      for their own needs, $$she is just there, $$enjoying life with me.
    displayText: In the middle of an environment where everyone tries to manipulate
      others for their own needs, she is just there, enjoying life with me.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 5f0000005f0000007200000072000000
    functionCalls: []
  - text: You seem very fond of her.$.$. $$How is she different from others?
    displayText: You seem very fond of her... How is she different from others?
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1a0000001b0000001d0000001d000000
    functionCalls: []
  - text: Well, $$firstly, $$she's not special at all. $$No talent. $$Not popular.
      $$Nothing notable except her extreme naivety.
    displayText: Well, firstly, she's not special at all. No talent. Not popular.
      Nothing notable except her extreme naivety.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000000f0000000f000000290000002900000034000000340000004100000041000000
    functionCalls: []
  - text: She never wanted to learn art from me. $$She never wanted to talk to me.
      $$She just sits beside me all the time, $$at every chance possible.
    displayText: She never wanted to learn art from me. She never wanted to talk
      to me. She just sits beside me all the time, at every chance possible.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 270000002700000047000000470000006d0000006d000000
    functionCalls: []
  - text: Isn't that.$.$. $$weird.$.$.?
    displayText: Isn't that... weird...?
    color: 0
    characterSprite: {fileID: 21300000, guid: b4e91975d53cca641b0139806b4b5627, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000c0000000e0000000e0000001400000015000000
    functionCalls: []
  - text: It is. $$It's super weird having someone following me like that and not
      even trying to speak to me. $$But it somehow felt comfortable.
    displayText: It is. It's super weird having someone following me like that and
      not even trying to speak to me. But it somehow felt comfortable.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 07000000070000006200000062000000
    functionCalls: []
  - text: It's like.$.$. $$that's the thing I'd been wanting all along. $$Just someone,
      $$being with me, $$being happy.$.$.
    displayText: It's like... that's the thing I'd been wanting all along. Just someone,
      being with me, being happy...
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0a0000000b0000000d0000000d0000003a0000003a000000480000004800000057000000570000006300000064000000
    functionCalls: []
  - text: Then, $$as if that happiness can be sent through air, $$the scent of plum
      blossom enters my nose and I feel like I'm allowed to be happy too.$.$.
    displayText: Then, as if that happiness can be sent through air, the scent of
      plum blossom enters my nose and I feel like I'm allowed to be happy too...
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000003400000034000000890000008a000000
    functionCalls: []
  - text: And that's why you consider her your first actual friend.$.$.
    displayText: And that's why you consider her your first actual friend...
    color: 0
    characterSprite: {fileID: 21300000, guid: b4e91975d53cca641b0139806b4b5627, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 390000003a000000
    functionCalls: []
  - text: Are you jealous? $$I can't pinpoint the exact date, $$but I have a strong
      feeling that you met me after Mahiru though.
    displayText: Are you jealous? I can't pinpoint the exact date, but I have a strong
      feeling that you met me after Mahiru though.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 11000000110000003200000032000000
    functionCalls: []
  - text: Haha.$.$. $$I think I am.$.$.
    displayText: Haha... I think I am...
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 050000000600000008000000080000001500000016000000
    functionCalls: []
  - text: One day, $$I thought it was the time to speak up, $$and I introduced myself
      to Mahiru. $$She instantly accepts me as a friend.
    displayText: One day, I thought it was the time to speak up, and I introduced
      myself to Mahiru. She instantly accepts me as a friend.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 090000000900000030000000300000005300000053000000
    functionCalls: []
  - text: But I guess I'm quite weak for this type of person.
    displayText: But I guess I'm quite weak for this type of person.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: She's so naive that I can't leave her alone, $$so I practically became
      an inseparable part of her life from then on.$.$.
    displayText: She's so naive that I can't leave her alone, so I practically became
      an inseparable part of her life from then on...
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2d0000002d0000007200000073000000
    functionCalls: []
  - text: '                                                                              '
    displayText: '                                                                              '
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 3
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls:
    - index: 0
      functionType: 0
      parameter: []
    - index: 0
      functionType: 1
      parameter:
      - boom
  - text: "Oh.$.$. $$We're still in this dimension, $$huh? $$My priority should be
      escaping this room.$.$.\u201D"
    displayText: "Oh... We're still in this dimension, huh? My priority should be
      escaping this room...\u201D"
    color: 0
    characterSprite: {fileID: 21300000, guid: 098a4f2cb9f2e2646b1a6906da2c3558, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0300000004000000060000000600000025000000250000002a0000002a0000005300000054000000
    functionCalls: []
  - text: Yeah.$.$. $$I think so.$.$.
    displayText: Yeah... I think so...
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 050000000600000008000000080000001300000014000000
    functionCalls: []
  - text: "Let's go, $$Maya. $$And sorry if telling stories about Mahiru makes you
      uncomfortable.$.$.\u201D"
    displayText: "Let's go, Maya. And sorry if telling stories about Mahiru makes
      you uncomfortable...\u201D"
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0a0000000a00000010000000100000005200000053000000
    functionCalls: []
  - text: Au.$.$.
    displayText: Au...
    color: 0
    characterSprite: {fileID: 21300000, guid: 4ec1ce6e63321a941829a1566caac4f2, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0300000004000000
    functionCalls: []
