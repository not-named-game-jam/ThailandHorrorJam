  dialogueSequence:
  - text: This bracelet is everywhere.$.$. $$What's the purpose of this?
    displayText: This bracelet is everywhere... What's the purpose of this?
    color: 0
    characterSprite: {fileID: 21300000, guid: 4ec1ce6e63321a941829a1566caac4f2, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1c0000001d0000001f0000001f000000
    functionCalls:
    - index: 0
      functionType: 1
      parameter:
      - ItemPickUp2
  - text: It does look like the one I'm always wearing. $$But why was I always wearing
      a bracelet? $$That's the question.
    displayText: It does look like the one I'm always wearing. But why was I always
      wearing a bracelet? That's the question.
    color: 0
    characterSprite: {fileID: 21300000, guid: 098a4f2cb9f2e2646b1a6906da2c3558, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2e0000002e0000005700000057000000
    functionCalls: []
  - text: Because you like it?
    displayText: Because you like it?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: No. $$Definitely not. $$I'm not the type to buy something like that and
      wear it.
    displayText: No. Definitely not. I'm not the type to buy something like that
      and wear it.
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 04000000040000001400000014000000
    functionCalls: []
  - text: Maybe you received it from someone?
    displayText: Maybe you received it from someone?
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: That's what I'm thinking about.$.$.
    displayText: That's what I'm thinking about...
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
