  dialogueSequence:
  - text: Blood stain.$.$.?
    displayText: Blood stain...?
    color: 0
    characterSprite: {fileID: 21300000, guid: 72c3981eaae6be5468be6dc68fac3515, type: 3}
    typeInterval: 0.045
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0c0000000d000000
    functionCalls:
    - index: 0
      functionType: 1
      parameter:
      - MainInteract1
  - text: Why is there a blood stain?
    displayText: Why is there a blood stain?
    color: 0
    characterSprite: {fileID: 21300000, guid: b4e91975d53cca641b0139806b4b5627, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Wait.$.$. $$I feel like I might be able to remember something.$.$.
    displayText: Wait... I feel like I might be able to remember something...
    color: 0
    characterSprite: {fileID: 21300000, guid: 780e7268fcdef544198c0b3d5d94d3f9, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 050000000600000008000000080000003a0000003b000000
    functionCalls: []
  - text: Rika, $$why can you remember something related to a blood stain.$.$.
    displayText: Rika, why can you remember something related to a blood stain...
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000003e0000003f000000
    functionCalls: []
  - text: I don't know, $$but it feels like it's an important topic.$.$. $$Wait a
      bit.$.$.
    displayText: I don't know, but it feels like it's an important topic... Wait
      a bit...
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0e0000000e00000038000000390000003b0000003b0000004600000047000000
    functionCalls: []
  - text: Rika. $$You don't have to try to dig up memories if it looks bad. $$It
      will only hurt you.$.$.
    displayText: Rika. You don't have to try to dig up memories if it looks bad.
      It will only hurt you...
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 060000000600000040000000400000005600000057000000
    functionCalls: []
  - text: Ha.$.$. $$I don't know.$.$.
    displayText: Ha... I don't know...
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 030000000400000006000000060000001300000014000000
    functionCalls: []
  - text: It's fine, $$Rika. $$Let's look at other stuff.
    displayText: It's fine, Rika. Let's look at other stuff.
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
