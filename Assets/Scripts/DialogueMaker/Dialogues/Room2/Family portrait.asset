--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd46f4c48ea13f644b49af6b289fdb82, type: 3}
  m_Name: Family portrait
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: Is this your family portrait? $$You look normal, $$happy even.$.$.
    displayText: Is this your family portrait? You look normal, happy even...
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1e0000001e0000002f0000002f0000003a0000003b000000
    functionCalls: []
  - text: Let me tell you something. $$The shutter speed of a normal camera is about
      10 milliseconds. $$And anyone can fake smiling for 10 milliseconds.
    displayText: Let me tell you something. The shutter speed of a normal camera
      is about 10 milliseconds. And anyone can fake smiling for 10 milliseconds.
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1b0000001b0000005a0000005a000000
    functionCalls: []
  - text: Au.$.$. $$Do you hate smiling that much.$.$.?
    displayText: Au... Do you fake smile that much...?
    color: 0
    characterSprite: {fileID: 21300000, guid: 4ec1ce6e63321a941829a1566caac4f2, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 030000000400000006000000060000002200000023000000
    functionCalls: []
  - text: Well, $$not around you. $$Just around adults, $$it's easier that way.
    displayText: Well, not around you. Just around adults, it's easier that way,
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 060000000600000016000000160000002a0000002a000000
    functionCalls: []
  - text: Okay Rika. $$Whatever$.$.$.
    displayText: Okay Rika. Whatever you say... Also, who's that old woman in the
      back? Photobombing?
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000b0000001c0000001d0000001f0000001f00000025000000250000004700000047000000
    functionCalls: []
  - text: Also, $$who's that old woman in the back? $$Photobombing?
    displayText: Okay Rika. Whatever you say... Also, who's that old woman in the
      back? Photobombing?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000b0000001c0000001d0000001f0000001f00000025000000250000004700000047000000
    functionCalls: []
  - text: Are you kidding me? $$That's my maternal grandmother. $$She's not on good
      terms with my mother though.
    displayText: Are you kidding me? That's my maternal grandmother. She's not on
      good terms with my mother though.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 14000000140000003400000034000000
    functionCalls: []
  - text: Why though? $$Shouldn't mother and daughter be nice to each other?
    displayText: Why though? Shouldn't mother and daughter be nice to each other?
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0c0000000c000000
    functionCalls: []
  - text: It's their family matter. $$I don't intend to dig deep into it.
    displayText: It's their family matter. I don't intend to dig deep into it.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1a0000001a000000
    functionCalls: []
  - text: But.$.$. $$You are their family.$.$.?
    displayText: But... You are their family...?
    color: 0
    characterSprite: {fileID: 21300000, guid: 4ec1ce6e63321a941829a1566caac4f2, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 040000000500000007000000070000001c0000001d000000
    functionCalls: []
  - text: You don't need to care about them. $$I've got the jigsaw piece behind the
      portrait already. $$Let's go.
    displayText: You don't need to care about them. I've got the jigsaw piece behind
      the portrait already. Let's go.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 23000000230000005a0000005a000000
    functionCalls: []
  - text: Okay, $$Rika.$.$.
    displayText: Okay, Rika...
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000000b0000000c000000
    functionCalls: []
  _currentLineIndex: -1
