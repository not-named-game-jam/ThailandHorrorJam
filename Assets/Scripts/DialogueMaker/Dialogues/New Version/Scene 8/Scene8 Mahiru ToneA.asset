  dialogueSequence:
  - text: "Oh\u2014sorry.$$$ Am I blocking the light?"
    displayText: "Oh\u2014sorry. Am I blocking the light?"
    color: 0
    characterSprite: {fileID: 21300000, guid: 53f7875a51b44fb4fb5e5d55d359d24e, type: 3}
    typeInterval: 0.06
    dialogueType: 2
