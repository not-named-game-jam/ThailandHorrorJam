    functionCalls: []
  - text: No.
    displayText: No.
    color: 0
    characterSprite: {fileID: 973624856, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "\u2026Let me know if you need anything."
    displayText: "\u2026Let me know if you need anything."
    color: 0
    characterSprite: {fileID: 21300000, guid: 9dbf43376f495f04aac5386d47b98338, type: 3}
    typeInterval: 0.06
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: ' (She just stayed by my side.)

'
    displayText: ' (She just stayed by my side.)

'
    color: 0
    characterSprite: {fileID: -4286266, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "(She stayed because she\u2019s kind.)"
    displayText: "(She stayed because she\u2019s kind.)"
    color: 0
    characterSprite: {fileID: -4286266, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: (Not because she wanted me.)
    displayText: (Not because she wanted me.)
    color: 0
    characterSprite: {fileID: 1735935646, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: ' (Anyone would have done the same.)'
    displayText: ' (Anyone would have done the same.)'
    color: 0
    characterSprite: {fileID: 2027173096, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "She didn\u2019t rush you."
    displayText: "She didn\u2019t rush you."
    color: 0
    characterSprite: {fileID: 341772219, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "She didn\u2019t have to."
    displayText: "She didn\u2019t have to."
    color: 0
    characterSprite: {fileID: 1741699914, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
