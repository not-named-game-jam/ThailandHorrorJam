  dialogueChoices:
  - choicesText: "\u201CThis classroom hasn\u2019t changed.\u201D"
    nextDialogue: {fileID: 0}
    dialogueConditions: []
    dialogueRewards: []
  - choicesText: "\u201CMaybe I wasn\u2019t the only one left behind.\u201D"
