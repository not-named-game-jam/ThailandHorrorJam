  dialogueSequence:
  - text: Did you get home yet?
    displayText: Did you get home yet?
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.03
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "We might be late tonight. Don\u2019t wait up."
    displayText: "We might be late tonight. Don\u2019t wait up."
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.03
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "There\u2019s money on the table. Make sure you eat something."
    displayText: "There\u2019s money on the table. Make sure you eat something."
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.03
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: 'See you tomorrow, love you.

'
    displayText: 'See you tomorrow, love you.

'
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.03
    dialogueType: 2
    typeSound: speak
    characterName: 
