  dialogueChoices:
  - choicesText: "\u201CEveryone\u2019s talking like usual.\u201D"
    nextDialogue: {fileID: 0}
    dialogueConditions: []
    dialogueRewards: []
  - choicesText: "\u201CThis was never just the two of us.\u201D"
