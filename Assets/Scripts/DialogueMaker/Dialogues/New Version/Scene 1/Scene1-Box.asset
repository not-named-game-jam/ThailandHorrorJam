  dialogueSequence:
  - text: "(Postcards from places I\u2019ve never been.)"
    displayText: 
    color: 0
    characterSprite: {fileID: 2011750063, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: (They always sent these things.)
    displayText: 
    color: 0
    characterSprite: {fileID: 2011750063, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: (Never be here themselves.)
    displayText: 
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: You kept all of them.
    displayText: 
    color: 0
    characterSprite: {fileID: -318979472, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: "They\u2019re one of the things that reminded me of them."
    displayText: 
    color: 0
    characterSprite: {fileID: -1225898225, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: I thought if I threw them away...
    displayText: 
    color: 0
    characterSprite: {fileID: -1953434355, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: "They\u2019d disappear for real."
    displayText: 
    color: 0
    characterSprite: {fileID: 973624856, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
