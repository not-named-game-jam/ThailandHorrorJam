  dialogueChoices:
  - choicesText: Everything feels louder here.
    nextDialogue: {fileID: 11400000, guid: 82c154e1a1710e543a0ce358d9380107, type: 2}
    dialogueConditions: []
    dialogueRewards:
    - rewardTypes: 1
      rewardName: SelfDoubt
      rewardValue: 1
  - choicesText: 'I still think I should do something. But I''m not sure if even
      if I do... it will really change anything. '
    nextDialogue: {fileID: 11400000, guid: 82c154e1a1710e543a0ce358d9380107, type: 2}
    dialogueConditions:
    - conditionTypes: 1
      Name: SelfDoubt
      comparisionType: 4
      Value: 32-37
    dialogueRewards:
    - rewardTypes: 1
      rewardName: SelfDoubt
      rewardValue: 1
    - rewardTypes: 1
      rewardName: SelfBlame
      rewardValue: 1
  - choicesText: "If I had stayed, none of this would\u2019ve happened."
    nextDialogue: {fileID: 11400000, guid: 82c154e1a1710e543a0ce358d9380107, type: 2}
    dialogueConditions:
    - conditionTypes: 1
      Name: SelfBlame
      comparisionType: 2
      Value: 90
    - conditionTypes: 1
      Name: SelfDoubt
      comparisionType: 1
      Value: 30
    dialogueRewards:
    - rewardTypes: 1
      rewardName: SelfBlame
      rewardValue: 2
  - choicesText: We both hesitated.
    nextDialogue: {fileID: 11400000, guid: 82c154e1a1710e543a0ce358d9380107, type: 2}
    dialogueConditions:
    - conditionTypes: 1
      Name: SelfDoubt
      comparisionType: 2
      Value: 38
    dialogueRewards:
    - rewardTypes: 1
      rewardName: SelfDoubt
      rewardValue: 2
  - choicesText: The sound cuts everything short, before any answer could exist.
    nextDialogue: {fileID: 11400000, guid: 82c154e1a1710e543a0ce358d9380107, type: 2}
    dialogueConditions: []
    dialogueRewards:
    - rewardTypes: 1
