    pauseIndex: 2a0000002a0000002a0000002a000000360000003600000037000000370000003800000038000000380000003800000038000000
    functionCalls: []
  - text: ~~~I'm not the cause of everything.
    displayText: I'm not the cause of everything.
    color: 0
    characterSprite: {fileID: 2011750063, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
