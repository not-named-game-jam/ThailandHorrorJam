  m_Name: Ending C
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: This is the final stop.$$$$ What do you think$$$$, Rika?
    displayText: This is the final stop. What do you think, Rika?
    color: 0
    characterSprite: {fileID: -2078441926, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: .$$$.$$$.
    displayText: ...
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 010000000100000001000000020000000200000002000000
    functionCalls: []
  - text: .$$$.$$$.
    displayText: ...
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 010000000100000001000000020000000200000002000000
    functionCalls: []
  - text: "I don\u2019t think I know anymore."
    displayText: "I don\u2019t think I know anymore."
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: .$$$.$$$.
    displayText: ...
    color: 0
    characterSprite: {fileID: 674674170, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 010000000100000001000000020000000200000002000000
    functionCalls: []
  - text: I keep replaying those moments again and again.
    displayText: I keep replaying those moments again and again.
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Trying to fix it.
    displayText: Trying to fix it.
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: To see whose fault it actually is.
    displayText: To see whose fault it actually is.
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "But the more I think about it\u2026 the less alone I am."
    displayText: "But the more I think about it\u2026 the less alone I am."
    color: 0
    characterSprite: {fileID: -142652558, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: About what?
    displayText: About what?
    color: 0
    characterSprite: {fileID: 674674170, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Everything.
    displayText: Everything.
    color: 0
    characterSprite: {fileID: -142652558, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: .$$$.$$$.$$$
    displayText: ...
    color: 0
    characterSprite: {fileID: 674674170, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 010000000100000001000000020000000200000002000000030000000300000003000000
    functionCalls: []
  - text: I'm still not sure what the whole truth is$$$$, but maybe.$$.$$.$$$$$ I'm
      not the cause of everything.
    displayText: I'm still not sure what the whole truth is, but maybe... I'm not
      the cause of everything.
    color: 0
    characterSprite: {fileID: -1567119930, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2a0000002a0000002a0000002a000000360000003600000037000000370000003800000038000000380000003800000038000000
    functionCalls: []
  - text: "And that\u2019s enough."
    displayText: "And that\u2019s enough."
    color: 0
    characterSprite: {fileID: -318979472, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: For now.$$.$$. you just have to keep walking.
    displayText: For now... you just have to keep walking.
    color: 0
    characterSprite: {fileID: -1234465409, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
