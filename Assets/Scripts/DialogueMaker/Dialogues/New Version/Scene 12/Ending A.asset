      parameter:
      - EndingA
      - 3
  - text: "~~~If.$$$.$$$.$$$ if Mahiru had never met me\u2013"
    displayText: "If... if Mahiru had never met me\u2013"
    color: 0
    characterSprite: {fileID: -142652558, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
