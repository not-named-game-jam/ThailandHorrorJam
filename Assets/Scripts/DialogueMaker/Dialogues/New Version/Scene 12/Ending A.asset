    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 01000000010000000200000002000000
    functionCalls: []
  - text: ~~~It was my fault.
    displayText: It was my fault.
    color: 0
    characterSprite: {fileID: -1962330079, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: ~~~.$$.$$.
    displayText: ...
    color: 0
    characterSprite: {fileID: 341772219, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 01000000010000000200000002000000
    functionCalls: []
  - text: ~~~If I hadn't walked away that day.
    displayText: If I hadn't walked away that day.
    color: 0
    characterSprite: {fileID: -1962330079, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: ~~~If I had chosen to speak up
    displayText: If I had chosen to speak up
    color: 0
    characterSprite: {fileID: -1962330079, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
