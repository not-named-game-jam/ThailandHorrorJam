    pauseIndex: 1d0000001d0000001d0000001d0000001d0000001d000000
    functionCalls: []
  - text: ~~~I'm just...$$$$ so tired$$$$$$$ I just want to rest...
    displayText: I'm just... so tired I just want to rest...
    color: 0
    characterSprite: {fileID: 2011750063, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
