    pauseIndex: 2700000027000000270000002700000028000000280000002800000028000000
    functionCalls:
    - index: 0
      functionType: 5
      parameter:
      - Ending
  - text: "~~~I don\u2019t want to think anymore$$$$$$, Maya."
    displayText: "I don\u2019t want to think anymore, Maya."
    color: 0
    characterSprite: {fileID: -142652558, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
    characterName: Rika
