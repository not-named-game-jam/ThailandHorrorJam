    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: Even when you barely answered.
    displayText: 
    color: 0
    characterSprite: {fileID: -2078441926, guid: e166fccd4362c7844accca5d43e8cac0, type: 3}
    typeInterval: 0.03
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  - text: ..Yeah, she did.
    displayText: 
    color: 0
    characterSprite: {fileID: 973624856, guid: e03e9e6f15669634cafbbe8d217c2db2, type: 3}
    typeInterval: 0.03
    dialogueType: 0
    typeSound: 
    characterName: 
    textColor: {r: 0, g: 0, b: 0, a: 0}
    pauseIndex: 
    functionCalls: []
  dialogueChoices:
  - choicesText: "\u201CShe spoke to me because no one else did.\u201D"
    nextDialogue: {fileID: 0}
    dialogueConditions: []
    dialogueRewards: []
  - choicesText: "\u201CHelp only proves I couldn\u2019t manage alone.\u201D"
    nextDialogue: {fileID: 0}
    dialogueConditions: []
    dialogueRewards: []
  - choicesText: "\u201CI owed her for staying.\u201D"
    nextDialogue: {fileID: 0}
    dialogueConditions: []
    dialogueRewards: []
  - choicesText: "\u201CIf I hadn\u2019t accepted it, she wouldn\u2019t be stuck.\u201D"
