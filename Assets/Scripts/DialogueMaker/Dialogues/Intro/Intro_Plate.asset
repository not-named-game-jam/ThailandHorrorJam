  m_Name: Intro_Plate
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: This stone plate is so dusty that I can't discern what it's for.
    displayText: This cactus looks exactly like the one I got pricked by when I was
      5.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Why is there a stone plate in a place like this anyway$.$.$.?
    displayText: Since then, I can somehow see myself in this kind of plants. It's
      kind of poetic, really.
    color: 0
