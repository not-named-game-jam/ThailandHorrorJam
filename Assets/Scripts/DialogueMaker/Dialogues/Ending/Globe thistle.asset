  - text: 'Respiratory rate: 16 breaths per minute'
    displayText: 'Respiratory rate: 16 breaths per minute'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika's fingers twitch against a cold and rough bed sheet.
    displayText: Rika's fingers twitch against a cold and rough bed sheet.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls:
    - index: 0
      functionType: 3
      parameter: []
  - text: The hospital's sanitized smell is as strong as ever. $$Rika doesn't like
      it.
    displayText: The hospital's sanitized smell is as strong as ever. Rika doesn't
      like it.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 3500000035000000
    functionCalls: []
  - text: She doesn't like much of anything, $$really.
    displayText: She doesn't like much of anything, really.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2300000023000000
    functionCalls: []
  - text: Agh.$.$.This smell makes me want to vomit.$.$.
    displayText: Agh...This smell makes me want to vomit...
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 04000000050000002800000029000000
    functionCalls: []
  - text: '"Rika.$.$."'
    displayText: '"Rika..."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 0600000007000000
    functionCalls: []
  - text: Rika looked at the source of the voice. $$It was her mother.
    displayText: Rika looked at the source of the voice. It was her mother.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2800000028000000
    functionCalls: []
  - text: I hate you.$.$.
    displayText: I hate you...
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.06
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000c000000
    functionCalls: []
  - text: '"That''s the first thing you say after you wake up, $$huh? $$Am I that
      bad of a mother?"'
    displayText: '"That''s the first thing you say after you wake up, huh? Am I that
      bad of a mother?"'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 33000000330000003800000038000000
    functionCalls: []
  - text: Her smile shows only sorrow.
    displayText: Her smile shows only sorrow.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Yes, $$you are.
    displayText: Yes, you are.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0500000005000000
    functionCalls: []
  - text: '".$.$.I''m sorry."'
    displayText: '"...I''m sorry."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.06
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 0200000003000000
    functionCalls: []
  - text: It's fine, $$I understand now. $$But I don't forgive you though.
    displayText: It's fine, I understand now. But I don't forgive you though.
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000b0000001d0000001d000000
    functionCalls: []
  - text: '"Okay.$.$."'
    displayText: '"Okay..."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.06
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 0600000007000000
    functionCalls: []
  - text: '".$.$."'
    displayText: '"..."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.06
    dialogueType: 2
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 0200000003000000
    functionCalls: []
  - text: '"This might not be the right time.$.$.., $$but here''s a gift from your
      friend. $$I should have given it to you a long time ago, $$but I never had
      the chance."'
    displayText: '"This might not be the right time...., but here''s a gift from
      your friend. I should have given it to you a long time ago, but I never had
      the chance."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 220000002300000027000000270000004b0000004b0000007a0000007a000000
    functionCalls: []
  - text: The mother passed a small box to Rika. $$There is a note attached to it,
      $$written in Mahiru's handwriting.
    displayText: The mother passed a small box to Rika. There is a note attached
      to it, written in Mahiru's handwriting.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 27000000270000004700000047000000
    functionCalls: []
  - text: The note reads, "You're nice. $$Everyone wants to be friends with you.
      $$Let's have fun together with them in the future!"
    displayText: The note reads, "You're nice. Everyone wants to be friends with
      you. Let's have fun together with them in the future!"
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1e0000001e0000004500000045000000
    functionCalls: []
  - text: Inside, $$there is a flower. $$A globe thistle.
    displayText: Inside, there is a flower. A globe thistle.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 08000000080000001b0000001b000000
    functionCalls: []
  - text: "\"If you don't like it, $$just throw it away. $$I just want to let you
      know that that girl does care about\u2014\""
    displayText: "\"If you don't like it, just throw it away. I just want to let
      you know that that girl does care about\u2014\""
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 17000000170000002b0000002b000000
    functionCalls: []
  - text: She was too naive.
    displayText: She was too naive.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
    typeInterval: 0.05
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '".$.$.so you will throw it away, $$huh? $$That''s what I thought.$.$."'
    displayText: '"...so you will throw it away, huh? That''s what I thought..."'
    color: 4
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: Mother
    textColor: {r: 0.2, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 02000000030000001f0000001f00000024000000240000003a0000003b000000
    functionCalls: []
  - text: No, $$I won't.
    displayText: No, I won't.
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
    typeInterval: 0.05
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0400000004000000
    functionCalls: []
  - text: The mother is confused.
    displayText: The mother is confused.
    color: 0
