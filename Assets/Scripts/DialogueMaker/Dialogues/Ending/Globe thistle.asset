    - index: 0
      functionType: 1
      parameter:
      - BassBoom
  - text: A steady beat. Beep Beep Beep
    displayText: A steady beat. Beep Beep Beep
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls:
    - index: 0
