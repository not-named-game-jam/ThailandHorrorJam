  m_Name: Plum blossom
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: '                                    '
    displayText: '                                    '
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.06
    dialogueType: 3
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls:
    - index: 0
      functionType: 5
      parameter:
      - RoomEnd Door4
    - index: 0
      functionType: 4
      parameter:
