    functionCalls:
    - index: 10
      functionType: 1
      parameter:
      - BassBoom
  - text: A steady tone. $$Continuous. $$Uninterrupted.
    displayText: A steady tone. Continuous. Uninterrupted.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0f0000000f0000001b0000001b000000
    functionCalls: []
  - text: Beeeeeeeeeeep
    displayText: Beeeeeeeeeeep
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
