    functionCalls: []
  - text: 'Time of death: 3:14 AM'
    displayText: 'Time of death: 3:14 AM'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: The nurse removed the respirator and pulled a white sheet over Rika's body.
    displayText: The nurse removed the respirator and pulled a white sheet over Rika's
      body.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```"Such a young girl.$.$."'
    displayText: '"Such a young girl..."'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 1
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1300000014000000
    functionCalls: []
  - text: '```"Did anyone ever come to visit her?"'
    displayText: '"Did anyone ever come to visit her?"'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 2
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```"No.$.$."'
    displayText: '"No..."'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 1
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0400000005000000
    functionCalls: []
  - text: '```"Hey, $$but I heard her mother tried to contact the hospital a few
      days ago. $$She''s trying to book a flight back to Japan."'
    displayText: '"Hey, but I heard her mother tried to contact the hospital a few
      days ago. She''s trying to book a flight back to Japan."'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 2
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000004b0000004b000000
    functionCalls: []
  - text: '```"It''s too late now.$.$. $$How sad.$.$."'
    displayText: '"It''s too late now... How sad..."'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 1
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 130000001400000016000000160000001e0000001f000000
    functionCalls: []
  - text: '```"Rest in peace, $$Konomi Rika.$.$. $$Life must have been painful for
      her to choose such an end. $$May the next life treat her more gently.$.$."'
    displayText: '"Rest in peace, Konomi Rika... Life must have been painful for
      her to choose such an end. May the next life treat her more gently..."'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: Nurse 2
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 10000000100000001c0000001d0000001f0000001f0000005a0000005a0000008200000083000000
