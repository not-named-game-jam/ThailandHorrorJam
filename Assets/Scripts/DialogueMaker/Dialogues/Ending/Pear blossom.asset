    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 4c0000004c0000007c0000007c0000009600000096000000bc000000bc000000
    functionCalls: []
  - text: And for the first time in a long, $$long time, $$Rika feels finally free.
    displayText: And for the first time in a long, long time, Rika feels finally
