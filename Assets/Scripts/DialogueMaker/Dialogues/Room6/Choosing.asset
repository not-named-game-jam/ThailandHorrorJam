  dialogueSequence:
  - text: Rika.$.$. $$Have you made your decision?
    displayText: Rika... Have you made your decision?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 05000000060000000800000008000000
    functionCalls: []
  - text: Yeah.$.$. $$Thank you, $$Maya.
    displayText: Yeah... Thank you, Maya.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 050000000600000008000000080000001300000013000000
    functionCalls: []
  - text: It really is different now when I have the full context, $$the whole truth,
      $$and being whole again even if my whole still is broken.
    displayText: It really is different now when I have the full context, the whole
      truth, and being whole again even if my whole still is broken.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 39000000390000004a0000004a000000
    functionCalls: []
  - text: I've decided.
    displayText: I've decided.
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.05
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: As a part of you, $$I already know what I'd choose too.$.$.
    displayText: As a part of you, I already know what I'd choose too...
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 12000000120000003500000036000000
    functionCalls: []
  - text: Rika and Maya grip their hands tightly. $$They look at each other.
    displayText: Rika and Maya grip their hands tightly. They look at each other.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2800000028000000
    functionCalls: []
  - text: Maya, $$how about we say it together?
    displayText: Maya, how about we say it together?
    color: 0
    characterSprite: {fileID: 21300000, guid: 31b5c86a24193cc45b592edca35cc68f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0600000006000000
    functionCalls: []
  - text: Alright.$.$. $$Three, $$two, $$one.$.$.
    displayText: Alright... Three, two, one...
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
