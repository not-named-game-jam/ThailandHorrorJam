  m_Script: {fileID: 11500000, guid: dd46f4c48ea13f644b49af6b289fdb82, type: 3}
  m_Name: Door 4
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: Rika, $$this is the door to continue your life. $$You don't need to have
      hope in anything, $$or even believe things will get better.
    displayText: Rika, this is the door to continue your life. You don't need to
      have hope in anything, or even believe things will get better.
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 06000000060000002e0000002e0000005700000057000000
    functionCalls:
    - index: 0
      functionType: 1
      parameter:
      - MainInteract2
  - text: As long as you still have the will to live, $$you can pick this door.
    displayText: As long as you still have the will to live, you can pick this door.
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 2c0000002c000000
    functionCalls: []
  - text: Nobody can force you to love the world that breaks you. $$Nobody can force
      you to forgive anyone, $$or to forgive yourself.
    displayText: Nobody can force you to love the world that breaks you. Nobody can
      force you to forgive anyone, or to forgive yourself.
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 38000000380000006000000060000000
    functionCalls: []
  - text: But you can choose to live.$.$.
    displayText: But you can choose to live...
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 1b0000001c000000
    functionCalls: []
  - text: Live in a world that will hurt you in the future. $$And you will live.
      $$Until the day you die for real.$.$. $$Is this what you want, $$Rika?
    displayText: Live in a world that will hurt you in the future. And you will live.
      Until the day you die for real... Is this what you want, Rika?
    color: 0
    characterSprite: {fileID: 21300000, guid: a7a112438f241d849b86cada18ec71c8, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 32000000320000004500000045000000640000006500000067000000670000007e0000007e000000
    functionCalls: []
  _currentLineIndex: -1
