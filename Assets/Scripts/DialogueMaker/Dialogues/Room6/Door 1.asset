  dialogueSequence:
  - text: Rika, $$this is the door to continue living. $$If you think that we are
      all flawed and nobody knows the correct answer to life, $$then this door is
      for you.
    displayText: Rika, this is the door to continue living. If you think that we
      are all flawed and nobody knows the correct answer to life, then this door
      is for you.
    color: 0
