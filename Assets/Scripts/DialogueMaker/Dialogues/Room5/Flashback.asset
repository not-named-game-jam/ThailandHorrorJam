--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dd46f4c48ea13f644b49af6b289fdb82, type: 3}
  m_Name: Flashback
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: Showing in the calendar is the date 4th of April, $$2025, $$the summer that
      should be hot, $$yet rain pours down, $$and a storm rages.
    displayText: Showing in the calendar is the date 4th of April, 2025, the summer
      that should be hot, yet rain pours down, and a storm rages.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Rika, $$why are you running away from me.$.$.?”'
    displayText: '“Rika, why are you running away from me...?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru said, $$chasing Rika up the stairs.
    displayText: Mahiru said, chasing Rika up the stairs.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“I have nothing to say to you.”'
    displayText: '“I have nothing to say to you.”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```(Why.$.$.?)'
    displayText: (Why...?)
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“I don''t even know what you''re even angry about.$.$. $$We''re friends,
      $$aren''t we? $$Friends should talk to each other when they are in trouble, $$right?
      $$Right.$.$.?”'
    displayText: '“I don''t even know what you''re even angry about... We''re friends,
      aren''t we? Friends should talk to each other when they are in trouble, right?
      Right...?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```(It hurts so much.$.$.)'
    displayText: (It hurts so much...)
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```(Why does it have to be like this?)'
    displayText: (Why does it have to be like this?)
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika stopped in the middle of the step, $$and Mahiru caught up to her.
    displayText: Rika stopped in the middle of the step, and Mahiru caught up to
      her.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru's hand grips on Rika's in a gentle way as always, $$like nothing
      just happened.
    displayText: Mahiru's hand grips on Rika's in a gentle way as always, like nothing
      just happened.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Also, $$it''s your birthday tomorrow. $$You should be happy, $$not angry
      on your birthday! I even have a gift for you! I think you will like it.$.$. $$hehe.$.$.”'
    displayText: '“Also, it''s your birthday tomorrow. You should be happy, not angry
      on your birthday! I even have a gift for you! I think you will like it... hehe...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“.$.$.A gift? $$Where?”'
    displayText: '“...A gift? Where?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Um.$.$. $$Sadly, $$it''s not your birthday yet. $$And this year, $$the 5th
      of April lands on Saturday, $$so I gave it to your kind mother when I met her
      last week.$.$.”'
    displayText: '“Um... Sadly, it''s not your birthday yet. And this year, the 5th
      of April lands on Saturday, so I gave it to your kind mother when I met her
      last week...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```(My kind mother.$.$. $$Really.$.$.?)'
    displayText: (My kind mother... Really...?)
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“I-I told her to give it to you tomorrow. $$But I don''t want to spoil
      it for you.$.$. $$Ah.$.$. $$But you might be even more angry if I don''t tell
      you what it is now.$.$. $$That''s bad.$.$. $$What do I do, $$what do I—”'
    displayText: '“I-I told her to give it to you tomorrow. But I don''t want to spoil
      it for you... Ah... But you might be even more angry if I don''t tell you what
      it is now... That''s bad... What do I do, what do I—”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Are you serious?”'
    displayText: '“Are you serious?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Eh?”'
    displayText: '“Eh?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“You''re speaking as if my mother will come home on Saturday.$.$.”'
    displayText: '“You''re speaking as if my mother will come home on Saturday...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“.$.$.What?”'
    displayText: '“...What?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru froze. $$Pure confusion is the only word that could describe her
      expression right now. $$Rika's situation is something alien, $$something unknown
      to her. $$And there's no way she can understand it.
    displayText: Mahiru froze. Pure confusion is the only word that could describe
      her expression right now. Rika's situation is something alien, something unknown
      to her. And there's no way she can understand it.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Rika.$.$. $$What are you talking about.$.$.? $$How can parents not be there
      on your birthday—”'
    displayText: '“Rika... What are you talking about...? How can parents not be there
      on your birthday—”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“You''re speaking as if they''re acting like parents to me.$.$.”'
    displayText: '“You''re speaking as if they''re acting like parents to me...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: A clap of thunder echoed around the sky.
    displayText: A clap of thunder echoed around the sky.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“W-Why are you talking about them like that? $$If they don''t have time,
      $$they might be very busy trying to—”'
    displayText: '“W-Why are you talking about them like that? If they don''t have
      time, they might be very busy trying to—”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“You''re speaking as if they care about me at all.$.$.”'
    displayText: '“You''re speaking as if they care about me at all...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: A streak of lightning split the dark clouds in the background.
    displayText: A streak of lightning split the dark clouds in the background.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Ah.$.$. $$Okay, $$okay.$.$. $$A-At least, $$you have me right.$.$.? $$If
      you and your parents aren''t on good terms, $$you can rely on friends. $$That''s
      what we are for. $$So.$.$. $$Just as I say.$.$. $$Let''s make a lot of friends
      and have fun—”'
    displayText: '“Ah... Okay, okay... A-At least, you have me right...? If you and
      your parents aren''t on good terms, you can rely on friends. That''s what we
      are for. So... Just as I say... Let''s make a lot of friends and have fun—”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```(“Let''s make a lot of friends and have fun.$.$.”)'
    displayText: '(“Let''s make a lot of friends and have fun...”)'
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 0
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: A sharp gust of wind pushed the corridor's windows open. $$An ominous sky
      hovering over the entire scene. $$But those chaotic sounds and sights are practically
      unnoticeable to Rika, $$as her mind is more tumultuous than the storm itself.
    displayText: A sharp gust of wind pushed the corridor's windows open. An ominous
      sky hovering over the entire scene. But those chaotic sounds and sights are
      practically unnoticeable to Rika, as her mind is more tumultuous than the storm
      itself.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: The corner of her mouth twitched, $$and Rika's distorted laugh spilled
      out of her involuntarily.
    displayText: The corner of her mouth twitched, and Rika's distorted laugh spilled
      out of her involuntarily.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Hahaha.$.$.”'
    displayText: '“Hahaha...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“R-Rika.$.$.?”'
    displayText: '“R-Rika...?”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika started to climb the stairs again. $$Away from Mahiru.
    displayText: Rika started to climb the stairs again. Away from Mahiru.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“.$.$.In the end, $$even you don''t understand me.”'
    displayText: '“...In the end, even you don''t understand me.”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Wait.$.$.!”'
    displayText: '“Wait...!”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Make a lot of friends and have fun.$.$. $$Are you serious? $$If you are,
      $$then I really don''t have anything to say to you anymore.$.$.”'
    displayText: '“Make a lot of friends and have fun... Are you serious? If you are,
      then I really don''t have anything to say to you anymore...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika reaches the top floor, $$and continues going up the stairs that lead
      to the rooftop, $$the rooftop where the thunderstorm is going on at full force.
    displayText: Rika reaches the top floor, and continues going up the stairs that
      lead to the rooftop, the rooftop where the thunderstorm is going on at full
      force.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru ran up.
    displayText: Mahiru ran up.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Rika.$.$. $$Wait.$.$.”'
    displayText: '“Rika... Wait...”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika is in front of the rooftop door, $$and Mahiru catches up to her again.
    displayText: Rika is in front of the rooftop door, and Mahiru catches up to her
      again.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“Rika!!!”'
    displayText: '“Rika!!!”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“I said I have nothing to say!”'
    displayText: '“I said I have nothing to say!”'
    color: 0
    characterSprite: {fileID: 21300000, guid: 3497fb685e16c034e905fb6d8391ba80, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Rika's hand shot out, $$shoving Mahiru's hand away.
    displayText: Rika's hand shot out, shoving Mahiru's hand away.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '“gasp—”'
    displayText: '“gasp—”'
    color: 0
    characterSprite: {fileID: 21300000, guid: f841aefe5e6e5364f8629fa39acecbdf, type: 3}
    typeInterval: 0.04
    dialogueType: 1
    typeSound: speak
    characterName: Mahiru
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: It was sudden.
    displayText: It was sudden.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Mahiru's body tilted backward.
    displayText: Mahiru's body tilted backward.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: Water leaked in from the windows, $$and the floor is wet.
    displayText: Water leaked in from the windows, and the floor is wet.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: bomb
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
