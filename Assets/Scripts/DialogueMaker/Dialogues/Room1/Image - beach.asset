  dialogueSequence:
  - text: A beach? $$You traveled there with your parents?
    displayText: A beach? You traveled there with your parents?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0900000009000000
    functionCalls: []
  - text: No. $$They never bring me anywhere on their own really.
    displayText: No. They never bring me anywhere on their own really.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0400000004000000
    functionCalls: []
  - text: That's sad.$.$.
    displayText: That's sad...
    color: 0
    characterSprite: {fileID: 21300000, guid: 4ec1ce6e63321a941829a1566caac4f2, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000c000000
    functionCalls: []
  - text: I don't know how I feel back then, $$but now I don't want to go there anyway.
      $$Beaches are not my style.
    displayText: I don't know how I feel back then, but now I don't want to go there
      anyway. Beaches are not my style.
