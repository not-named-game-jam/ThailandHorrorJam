    pauseIndex: 0500000005000000140000001500000016000000
    functionCalls: []
  - text: Uh$.$.$. $$Why are you thinking of blood? $$Is there something wrong?
    displayText: Uh... Why are you thinking of blood? Is there something wrong?
    color: 0
    characterSprite: {fileID: 21300000, guid: 72c3981eaae6be5468be6dc68fac3515, type: 3}
