    pauseIndex: 0d0000000d000000
    functionCalls: []
  - text: Scared of ghosts, $$Rika?
    displayText: Let's give it to her!
    color: 0
    characterSprite: {fileID: 21300000, guid: 1899c048cbc3cbf46ad8477960b7a91e, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: "Not really. $$If ghosts exist, $$I would want to see it with my own eyes,
      $$and I wouldn\u2019t be able to see without a flashlight."
