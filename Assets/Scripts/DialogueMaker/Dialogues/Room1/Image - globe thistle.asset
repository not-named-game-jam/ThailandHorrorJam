  m_Name: Image - globe thistle
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: What's that flower?
    displayText: A beach? You traveled there with your parents?
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: It's ugly, $$isn't it?
    displayText: No. They never bring me anywhere on their own really.
    color: 0
    characterSprite: {fileID: 21300000, guid: 098a4f2cb9f2e2646b1a6906da2c3558, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0400000004000000
    functionCalls: []
  - text: N-No.$.$. $$Your drawing is quite on the realistic side. $$Good job! Haha.$.$.
    displayText: That's sad...
    color: 0
    characterSprite: {fileID: 21300000, guid: 6ba46ecacc866544da47236fc876b59f, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 0b0000000c000000
    functionCalls: []
  - text: I'm talking about the flower itself. $$Not my drawing skill.
    displayText: I don't know how I feel back then, but now I don't want to go there
      anyway. Beaches are not my style.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 23000000230000004c0000004c000000
    functionCalls: []
  - text: Ah.$.$. $$In that case.$.$. $$Is it really ugly though? $$It's just a flower.
    displayText: I don't know how I feel back then, but now I don't want to go there
      anyway. Beaches are not my style.
    color: 0
    characterSprite: {fileID: 21300000, guid: 72c3981eaae6be5468be6dc68fac3515, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 23000000230000004c0000004c000000
    functionCalls: []
  - text: I don't know about you, $$but I think it's ugly. $$And that's why I drew
      it.
    displayText: I don't know how I feel back then, but now I don't want to go there
      anyway. Beaches are not my style.
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 23000000230000004c0000004c000000
    functionCalls: []
  _currentLineIndex: -1
