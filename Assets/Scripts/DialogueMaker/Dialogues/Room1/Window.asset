  m_Script: {fileID: 11500000, guid: dd46f4c48ea13f644b49af6b289fdb82, type: 3}
  m_Name: Window
  m_EditorClassIdentifier: 
  dialogueSequence:
  - text: There are kids playing outside.
    displayText: What flower is this? Do you know, Rika?
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 15000000150000002200000022000000
    functionCalls: []
  - text: Don't you want to go with them?
    displayText: It's Rika.
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: No. $$Trying to create a good drawing is hard enough.
    displayText: ...? I know your name. Or did I pronounce it wrong?
    color: 0
    characterSprite: {fileID: 21300000, guid: ee76e5e7fa787224cae55b97276c9bc0, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 01000000020000000300000005000000050000001700000017000000
    functionCalls: []
  - text: .$.$.Really? You don't want to play with others even a bit?
    displayText: No, I mean, the flower is Rika, a pear blossom. My parents named
      me after it.
    color: 0
    characterSprite: {fileID: 21300000, guid: e7de67e2d95a03d4b82bb6e2e759966a, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 04000000040000000c0000000c00000020000000200000003000000030000000
    functionCalls: []
  - text: Maybe I'll like it if I get to play with them. $$But my parents never really
      introduce me to them, $$so.$.$. I don't know.
    displayText: Aww... Naming a daughter after a flower is such an adorable thing
      to do...
    color: 0
    characterSprite: {fileID: 21300000, guid: 098a4f2cb9f2e2646b1a6906da2c3558, type: 3}
    typeInterval: 0.036
    dialogueType: 1
    typeSound: speak
    characterName: Maya
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 040000000500000007000000070000004800000049000000
    functionCalls: []
  _currentLineIndex: -1
