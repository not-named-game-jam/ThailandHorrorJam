    pauseIndex: 06000000060000001c0000001c000000
    functionCalls: []
  - text: And she will probably keep drawing for a long long time.
    displayText: And she will probably keep drawing for a long long time.
    color: 0
    characterSprite: {fileID: 21300000, guid: dd7424e912b1ed242be9b05b9e0c8d66, type: 3}
