    functionCalls: []
  - text: Look. $$Her hands move again. $$She's drawing.
    displayText: Look. Her hands move again. She's drawing.
    color: 0
    characterSprite: {fileID: 21300000, guid: bae9cd182668b904b879f7cbcdf2e654, type: 3}
