    displayText: Rika revealed her twisted face, and her painful tears, and her trembling
      mouth.
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 20000000200000003700000037000000
    functionCalls: []
  - text: She gasped for air with a deep breath.$.$.
    displayText: She gasped for air with a deep breath...
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 2
    typeSound: speak
    characterName: 
