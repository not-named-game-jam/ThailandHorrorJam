    dialogueType: 1
    typeSound: speak
    characterName: Rika
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 0300000003000000050000000600000008000000080000001e0000001e0000002b0000002b0000003e0000003f000000
    functionCalls: []
  - text: '                                                          '
    displayText: '                                                          '
    color: 1
    characterSprite: {fileID: 21300000, guid: e23284570d4398b45acdfcf5a62324b6, type: 3}
