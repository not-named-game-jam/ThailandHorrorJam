    pauseIndex: 
    functionCalls: []
  - text: Rika walked along it, $$one step at a time, $$each step cutting into her
      skin deeper and deeper.
    displayText: Rika walked along it, one step at a time, each step cutting into
      her skin deeper and deeper.
    color: 0
