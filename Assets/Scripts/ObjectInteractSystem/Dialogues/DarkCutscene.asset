    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.9098, g: 0.9255, b: 0.9333, a: 1}
    pauseIndex: 
