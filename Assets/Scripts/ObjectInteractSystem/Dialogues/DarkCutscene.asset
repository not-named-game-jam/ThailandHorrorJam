    functionCalls: []
  - text: Let me tell myself this.$.$. $$It's creepy to have an imaginary friend
      at this age.
    displayText: Let me tell myself this... It's creepy to have an imaginary friend
      at this age.
    color: 0
    characterSprite: {fileID: 21300000, guid: 4a4248579003fdf418680a2fa89b0526, type: 3}
