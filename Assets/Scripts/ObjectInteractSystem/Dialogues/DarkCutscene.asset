    typeInterval: 0.0503
    dialogueType: 0
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```She''s Dead.'
    displayText: She's Dead.
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.12
    dialogueType: 0
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '```Dead. $Dead. $Dead. $Dead. $Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead.  '
    displayText: 'Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead. Dead.
      Dead. Dead. Dead. Dead.  '
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.01
    dialogueType: 0
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 060000000c0000001200000018000000
    functionCalls: []
  - text: "This is how things turned out. $$And there's no redoing.\r"
    displayText: "This is how things turned out. And there's no redoing.\r"
    color: 5
    characterSprite: {fileID: 0}
    typeInterval: 0.04
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.6, g: 0.6, b: 0.6, a: 1}
    pauseIndex: 1f0000001f000000
    functionCalls: []
  - text: Mahiru's Dead.
    displayText: Mahiru's Dead.
    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.08
    dialogueType: 2
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
  - text: '                                   '
    displayText: '                                   '
    color: 0
    characterSprite: {fileID: 0}
