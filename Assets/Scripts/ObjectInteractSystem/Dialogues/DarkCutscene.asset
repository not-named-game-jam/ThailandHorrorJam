    color: 1
    characterSprite: {fileID: 0}
    typeInterval: 0.0503
    dialogueType: 0
    typeSound: speak
    characterName: 
    textColor: {r: 0.733, g: 0.0667, b: 0.2157, a: 1}
    pauseIndex: 
    functionCalls: []
