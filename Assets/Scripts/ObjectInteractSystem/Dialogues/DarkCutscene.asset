    pauseIndex: 
    functionCalls: []
  - text: 'The path towards the exit of this room revealed itself decorated with
      rotten pear blossoms and shards of broken glasses. '
    displayText: 'The path towards the exit of this room revealed itself decorated
      with rotten pear blossoms and shards of broken glasses. '
    color: 0
    characterSprite: {fileID: 0}
    typeInterval: 0.036
