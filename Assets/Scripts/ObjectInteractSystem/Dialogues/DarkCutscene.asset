    pauseIndex: 
    functionCalls: []
  - text: You, $$Rika, $$can deny me all you want. $$I won't stop you. $$I know you.
      $$I am you.
    displayText: You, Rika, can deny me all you want. I won't stop you. I know you.
      I am you.
